# Copy to .env.local for local dev. On Vercel: Project > Settings > Environment Variables.
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Public URL of the deployed site (used in email confirmation / password reset links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NOT NEEDED by this app. Never add the service_role key to Vercel or to any NEXT_PUBLIC_ variable.
# SUPABASE_SERVICE_ROLE_KEY=
